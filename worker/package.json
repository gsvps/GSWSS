{
  "name": "gs-protocol-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "cloudflare": {
    "bindings": {
      "PASSWORD": {
        "description": "GS Protocol 认证密码，客户端 `config.yaml` 中的 `password` 须与此一致。建议使用 `openssl rand -hex 16` 生成。"
      }
    }
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.4.0"
  }
}
